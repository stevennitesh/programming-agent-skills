{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/programming-agent-skills/value-stock/model-lock-v1.schema.json",
  "title": "Value Stock Model Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "issuer_id",
    "security_id",
    "as_of_date",
    "reporting_currency",
    "method",
    "base_scenario",
    "scenarios",
    "periods",
    "conventions",
    "diluted_shares",
    "inputs"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "method": {"enum": ["fcff", "residual_income"]},
    "base_scenario": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "date"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["historical", "stub", "forecast", "terminal", "valuation"]
          },
          "date": {"type": "string", "format": "date"}
        }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing", "terminal"],
      "properties": {
        "timing": {"enum": ["explicit", "midyear", "year_end"]},
        "terminal": {
          "enum": ["none", "perpetual_growth", "continuing_residual_income"]
        }
      }
    },
    "diluted_shares": {
      "allOf": [
        {"$ref": "#/$defs/valueRecord"},
        {
          "properties": {
            "unit": {"const": "shares"},
            "value_kind": {"const": "non_monetary"},
            "currency": {"const": null},
            "claim_basis": {"const": "target_security"}
          }
        }
      ]
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "allOf": [
          {"$ref": "#/$defs/valueRecord"},
          {
            "not": {
              "required": ["formula_ref"],
              "properties": {
                "formula_ref": {
                  "enum": [
                    "fcff-v1:nopat-plus-da-minus-capex-minus-working-capital-change",
                    "fcff-v2:direct-last-fcff-times-one-plus-growth",
                    "fcff-v2:stable-nopat-minus-growth-reinvestment",
                    "residual-income-v1:roe-times-beginning-book-value",
                    "residual-income-v1:net-income-minus-equity-charge",
                    "residual-income-v1:beginning-book-plus-net-income-minus-dividends-plus-adjustments",
                    "residual-income-v1:next-residual-income-over-ke-minus-growth"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "fcff": {"$ref": "#/$defs/fcffModel"},
    "residual_income": {"$ref": "#/$defs/residualIncomeModel"}
  },
  "$defs": {
    "fcffModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecast_periods",
        "terminal",
        "claim_bridge",
        "award_treatment"
      ],
      "properties": {
        "midyear_first_prior_period_end": {
          "type": "string",
          "format": "date"
        },
        "forecast_periods": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fcffForecastPeriod"}
        },
        "terminal": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/fcffTerminal"}
          ]
        },
        "claim_bridge": {"$ref": "#/$defs/fcffClaimBridge"},
        "award_treatment": {"$ref": "#/$defs/fcffAwardTreatment"}
      }
    },
    "fcffForecastPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "realization_date",
        "branch",
        "discount_rate_input"
      ],
      "properties": {
        "period": {"type": "string", "minLength": 1},
        "realization_date": {"type": "string", "format": "date"},
        "branch": {"enum": ["derived", "direct"]},
        "output_input": {"type": "string", "minLength": 1},
        "discount_rate_input": {"type": "string", "minLength": 1},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ebit",
            "tax_rate",
            "depreciation_amortization",
            "capital_expenditures",
            "working_capital_change"
          ],
          "properties": {
            "ebit": {"type": "string", "minLength": 1},
            "tax_rate": {"type": "string", "minLength": 1},
            "depreciation_amortization": {"type": "string", "minLength": 1},
            "capital_expenditures": {"type": "string", "minLength": 1},
            "working_capital_change": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"branch": {"const": "derived"}}},
          "then": {
            "required": ["components"],
            "not": {"required": ["output_input"]}
          },
          "else": {
            "required": ["output_input"],
            "not": {"required": ["components"]}
          }
        }
      ]
    },
    "fcffTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "terminal_date",
        "discount_rate_input",
        "growth_rate_input"
      ],
      "properties": {
        "branch": {
          "enum": ["direct_fcff_growth", "stable_economics"]
        },
        "terminal_date": {"type": "string", "format": "date"},
        "discount_rate_input": {"type": "string", "minLength": 1},
        "growth_rate_input": {"type": "string", "minLength": 1},
        "next_period_nopat_input": {"type": "string", "minLength": 1},
        "return_on_new_invested_capital_input": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"branch": {"const": "stable_economics"}}
          },
          "then": {
            "required": [
              "next_period_nopat_input",
              "return_on_new_invested_capital_input"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["next_period_nopat_input"]},
                {"required": ["return_on_new_invested_capital_input"]}
              ]
            }
          }
        }
      ]
    },
    "fcffClaimBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excess_cash",
        "non_operating_assets",
        "debt",
        "preferred_stock",
        "noncontrolling_interests",
        "other_senior_claims",
        "existing_awards",
        "target_claim_adjustments"
      ],
      "properties": {
        "excess_cash": {"$ref": "#/$defs/inputReferenceArray"},
        "non_operating_assets": {"$ref": "#/$defs/inputReferenceArray"},
        "debt": {"$ref": "#/$defs/inputReferenceArray"},
        "preferred_stock": {"$ref": "#/$defs/inputReferenceArray"},
        "noncontrolling_interests": {"$ref": "#/$defs/inputReferenceArray"},
        "other_senior_claims": {"$ref": "#/$defs/inputReferenceArray"},
        "existing_awards": {"$ref": "#/$defs/inputReferenceArray"},
        "target_claim_adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect", "input"],
            "properties": {
              "effect": {"enum": ["add", "subtract"]},
              "input": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "inputReferenceArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fcffAwardTreatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existing_awards",
        "future_grants",
        "future_grants_claim_adjustment"
      ],
      "properties": {
        "existing_awards": {"enum": ["none", "claim_bridge", "diluted_shares"]},
        "future_grants": {
          "enum": ["none", "operating_expense", "cash_equivalent", "future_dilution"]
        },
        "future_grants_claim_adjustment": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      }
    },
    "residualIncomeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forecast_periods", "terminal"],
      "properties": {
        "forecast_periods": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/residualIncomeForecastPeriod"}
        },
        "terminal": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/residualIncomeTerminal"}
          ]
        },
        "claim_bridge": {"$ref": "#/$defs/residualIncomeClaimBridge"},
        "award_treatment": {"$ref": "#/$defs/residualIncomeAwardTreatment"}
      },
      "dependentRequired": {
        "claim_bridge": ["award_treatment"],
        "award_treatment": ["claim_bridge"]
      }
    },
    "residualIncomeClaimBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existing_awards", "target_claim_adjustments"],
      "properties": {
        "existing_awards": {"$ref": "#/$defs/inputReferenceArray"},
        "target_claim_adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect", "input"],
            "properties": {
              "effect": {"enum": ["add", "subtract"]},
              "input": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "residualIncomeAwardTreatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existing_awards"],
      "properties": {
        "existing_awards": {
          "enum": ["none", "claim_bridge", "diluted_shares"]
        }
      }
    },
    "residualIncomeForecastPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "realization_date",
        "branch",
        "required_return_input",
        "dividends_input",
        "clean_surplus_adjustment_inputs"
      ],
      "properties": {
        "period": {"type": "string", "minLength": 1},
        "realization_date": {"type": "string", "format": "date"},
        "branch": {"enum": ["direct_net_income", "roe_derived"]},
        "beginning_book_value_input": {"type": "string", "minLength": 1},
        "net_income_input": {"type": "string", "minLength": 1},
        "roe_input": {"type": "string", "minLength": 1},
        "required_return_input": {"type": "string", "minLength": 1},
        "dividends_input": {"type": "string", "minLength": 1},
        "clean_surplus_adjustment_inputs": {"$ref": "#/$defs/inputReferenceArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"branch": {"const": "direct_net_income"}}},
          "then": {
            "required": ["net_income_input"],
            "not": {"required": ["roe_input"]}
          },
          "else": {
            "required": ["roe_input"],
            "not": {"required": ["net_income_input"]}
          }
        }
      ]
    },
    "residualIncomeTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_date",
        "required_return_input",
        "roe_input",
        "growth_rate_input"
      ],
      "properties": {
        "terminal_date": {"type": "string", "format": "date"},
        "required_return_input": {"type": "string", "minLength": 1},
        "roe_input": {"type": "string", "minLength": 1},
        "growth_rate_input": {"type": "string", "minLength": 1}
      }
    },
    "valueRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "value_kind",
        "currency",
        "evidence_class",
        "claim_basis",
        "scenario"
      ],
      "properties": {
        "value": {"type": "number"},
        "unit": {
          "enum": [
            "currency",
            "currency_per_period",
            "currency_per_share",
            "shares",
            "percent",
            "ratio",
            "count"
          ]
        },
        "value_kind": {"enum": ["monetary", "non_monetary"]},
        "currency": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Z]{3}$"}
          ]
        },
        "date": {"type": "string", "format": "date"},
        "period": {"type": "string", "minLength": 1},
        "evidence_class": {
          "enum": ["reported", "guided", "estimated", "assumed", "calculated"]
        },
        "claim_basis": {
          "enum": [
            "operating",
            "enterprise",
            "debt",
            "preferred",
            "noncontrolling_interest",
            "common_equity",
            "target_security",
            "other"
          ]
        },
        "scenario": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "formula_ref": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"value_kind": {"const": "monetary"}}},
          "then": {
            "properties": {
              "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
              "unit": {
                "enum": ["currency", "currency_per_period", "currency_per_share"]
              }
            }
          },
          "else": {
            "properties": {
              "currency": {"const": null},
              "unit": {"enum": ["shares", "percent", "ratio", "count"]}
            }
          }
        },
        {
          "oneOf": [
            {"required": ["date"], "not": {"required": ["period"]}},
            {"required": ["period"], "not": {"required": ["date"]}}
          ]
        },
        {
          "oneOf": [
            {"required": ["source_ref"], "not": {"required": ["formula_ref"]}},
            {"required": ["formula_ref"], "not": {"required": ["source_ref"]}}
          ]
        }
      ]
    }
  }
}
