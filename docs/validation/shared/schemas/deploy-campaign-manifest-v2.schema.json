{
  "$id": "urn:programming-agent-skills:deploy-campaign-manifest:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "campaign": {
      "additionalProperties": false,
      "properties": {
        "composition_epoch_id": {
          "pattern": "^FCE-[0-9]{8}-[0-9]{2}$",
          "type": "string"
        },
        "continuation": {
          "enum": [
            "restart",
            null
          ]
        },
        "delivery_mode": {
          "enum": [
            "none",
            "commit",
            "push"
          ]
        },
        "epoch": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "skill": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "supersession": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^docs/validation/skills/[a-z0-9][a-z0-9-]*/campaigns/[a-z0-9][a-z0-9-]*/manifest\\.json$",
              "type": "string"
            }
          ]
        },
        "worktree": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "skill",
        "epoch",
        "composition_epoch_id",
        "delivery_mode",
        "continuation",
        "supersession",
        "worktree"
      ],
      "type": "object"
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "pack_contract": {
          "$ref": "#/$defs/revisionedPointer"
        },
        "independent_m0": {
          "$ref": "#/$defs/artifactPointer"
        },
        "proof_predecessors": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "installed": {
                "$ref": "#/$defs/artifactPointer"
              },
              "p1": {
                "$ref": "#/$defs/artifactPointer"
              }
            },
            "required": [
              "id",
              "p1",
              "installed"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "schedule_pointer": {
          "minLength": 1,
          "type": "string"
        },
        "schedule_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "selected_capability_ids": {
          "$ref": "#/$defs/identityList"
        },
        "selected_relationship_ids": {
          "$ref": "#/$defs/identityList"
        },
        "selected_scenario_ids": {
          "$ref": "#/$defs/identityList"
        },
        "slice": {
          "additionalProperties": false,
          "properties": {
            "fingerprint": {
              "$ref": "#/$defs/fingerprint"
            },
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id",
            "path",
            "fingerprint"
          ],
          "type": "object"
        }
      },
      "required": [
        "pack_contract",
        "slice",
        "independent_m0",
        "selected_capability_ids",
        "selected_relationship_ids",
        "selected_scenario_ids",
        "proof_predecessors",
        "schedule_pointer",
        "schedule_fingerprint"
      ],
      "type": "object"
    },
    "mechanical": {
      "additionalProperties": false,
      "properties": {
        "artifact_identities": {
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "campaign_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "contract_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_state": {
          "enum": [
            "current",
            "stale"
          ]
        },
        "invalidations": {
          "items": {
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "receipt_ids"
                ]
              },
              {
                "required": [
                  "changed_inputs"
                ]
              },
              {
                "required": [
                  "changed_contract_fields"
                ]
              }
            ],
            "properties": {
              "changed_contract_fields": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "changed_inputs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "observed_at": {
                "format": "date-time",
                "type": "string"
              },
              "receipt_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "observed_at"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "parity": {},
        "preflight_registrations": {
          "type": "array"
        },
        "proof_registrations": {
          "type": "array"
        },
        "receipts": {
          "type": "array"
        },
        "supersession_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "created_at",
        "campaign_digest",
        "supersession_digest",
        "contract_digest",
        "verified_at",
        "artifact_identities",
        "proof_registrations",
        "preflight_registrations",
        "receipts",
        "invalidations",
        "parity",
        "evidence_state"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 2
    },
    "semantic": {
      "additionalProperties": false,
      "properties": {
        "lifecycle": {
          "additionalProperties": false,
          "properties": {
            "h1": {
              "minLength": 1,
              "type": "string"
            },
            "m0": {
              "minLength": 1,
              "type": "string"
            },
            "p1": {
              "minLength": 1,
              "type": "string"
            },
            "proof": {
              "minLength": 1,
              "type": "string"
            },
            "pruning": {
              "minLength": 1,
              "type": "string"
            },
            "research": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "m0",
            "research",
            "h1",
            "proof",
            "pruning",
            "p1"
          ],
          "type": "object"
        },
        "pointers": {
          "additionalProperties": false,
          "properties": {
            "claim_adjacency": {
              "minLength": 1,
              "type": "string"
            },
            "decision_capsule": {
              "pattern": "^decisions\\.md#.+$",
              "type": "string"
            },
            "pack_synthesis": {
              "minLength": 1,
              "type": "string"
            },
            "research_packet": {
              "minLength": 1,
              "type": "string"
            },
            "skill_synthesis": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "decision_capsule",
            "research_packet",
            "skill_synthesis",
            "claim_adjacency",
            "pack_synthesis"
          ],
          "type": "object"
        },
        "stage_token": {
          "enum": [
            "prompt-1",
            "research",
            "prompt-2",
            "prompt-3",
            "prompt-4",
            "pruning",
            "prompt-5"
          ]
        },
        "terminal_token": {
          "enum": [
            "campaign-complete",
            null
          ]
        }
      },
      "required": [
        "stage_token",
        "terminal_token",
        "lifecycle",
        "pointers"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "campaign",
    "contract",
    "semantic",
    "mechanical"
  ],
  "type": "object",
  "$defs": {
    "artifactPointer": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "fingerprint"
      ],
      "type": "object"
    },
    "fingerprint": {
      "pattern": "^sha256-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "identityList": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "revisionedPointer": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "revision",
        "fingerprint"
      ],
      "type": "object"
    }
  }
}
