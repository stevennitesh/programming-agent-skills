{
  "$id": "urn:programming-agent-skills:pack-composition-contract:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance_scenario_ids": {"items": {"type": "string"}, "type": "array"},
          "allowed_contributor_skill_ids": {"items": {"pattern": "^SK-[0-9]{3}$", "type": "string"}, "type": "array"},
          "capability_id": {"pattern": "^CAP-[0-9]{3}$", "type": "string"},
          "completion_return": {"minLength": 1, "type": "string"},
          "disposition": {"enum": ["selected", "deferred-nonessential", "out-of-pack"]},
          "entry_conditions": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
          "essential": {"type": "boolean"},
          "exclusions": {"items": {"type": "string"}, "type": "array"},
          "observable_outcome": {"minLength": 1, "type": "string"},
          "primary_owner_skill_id": {"pattern": "^SK-[0-9]{3}$", "type": ["string", "null"]},
          "proof_class": {"minLength": 1, "type": "string"},
          "required_authority_mutation": {"items": {"type": "string"}, "type": "array"}
        },
        "required": ["capability_id", "essential", "observable_outcome", "entry_conditions", "completion_return", "required_authority_mutation", "primary_owner_skill_id", "allowed_contributor_skill_ids", "exclusions", "acceptance_scenario_ids", "proof_class", "disposition"],
        "type": "object"
      },
      "type": "array"
    },
    "epoch_header": {
      "additionalProperties": false,
      "properties": {
        "acceptance_scenarios": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {"minLength": 1, "type": "string"},
              "expected_owner_skill_id": {"pattern": "^SK-[0-9]{3}$", "type": "string"},
              "scenario_id": {"pattern": "^PS-[0-9]{3}$", "type": "string"}
            },
            "required": ["scenario_id", "description", "expected_owner_skill_id"],
            "type": "object"
          },
          "type": "array"
        },
        "campaign_proof_graph": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "predecessor_skill_id": {"pattern": "^SK-[0-9]{3}$", "type": "string"},
              "successor_skill_id": {"pattern": "^SK-[0-9]{3}$", "type": "string"}
            },
            "required": ["predecessor_skill_id", "successor_skill_id"],
            "type": "object"
          },
          "type": "array"
        },
        "composition_epoch_id": {"pattern": "^FCE-[0-9]{8}-[0-9]{2}$", "type": ["string", "null"]},
        "contract_revision": {"minimum": 0, "type": "integer"},
        "epoch_lock": {
          "oneOf": [
            {"type": "null"},
            {
              "additionalProperties": false,
              "properties": {
                "evidence_pointer": {"minLength": 1, "type": "string"},
                "lock_id": {"minLength": 1, "type": "string"}
              },
              "required": ["lock_id", "evidence_pointer"],
              "type": "object"
            }
          ]
        },
        "exclusions": {"items": {"type": "string"}, "type": "array"},
        "fixed_point": {
          "additionalProperties": false,
          "properties": {
            "environment": {"type": ["string", "null"]},
            "repository_tree": {"type": ["string", "null"]},
            "timestamp": {"type": ["string", "null"]}
          },
          "required": ["repository_tree", "environment", "timestamp"],
          "type": "object"
        },
        "integration_result": {
          "additionalProperties": false,
          "properties": {
            "decision": {"enum": [null, "integration-accepted", "needs-more-evidence", "blocked"]},
            "evidence_pointer": {"type": ["string", "null"]}
          },
          "required": ["decision", "evidence_pointer"],
          "type": "object"
        },
        "intended_pack_outcome": {"type": ["string", "null"]},
        "load_budget_policy": {
          "additionalProperties": false,
          "properties": {
            "ceiling_or_class": {"type": ["string", "null"]},
            "metric": {"type": ["string", "null"]},
            "status": {"enum": ["gap", "set"]}
          },
          "required": ["metric", "ceiling_or_class", "status"],
          "type": "object"
        },
        "research_bound": {
          "additionalProperties": false,
          "properties": {
            "catalog_reconciliation_passes": {"const": 1},
            "independent_passes": {"const": 1},
            "named_gap_passes": {"const": 1}
          },
          "required": ["independent_passes", "catalog_reconciliation_passes", "named_gap_passes"],
          "type": "object"
        },
        "schema_version": {"const": 1},
        "scope": {"items": {"type": "string"}, "type": "array"},
        "source_pointers": {"items": {"type": "string"}, "type": "array"},
        "status": {"enum": ["draft", "frozen", "campaign-active", "integration-accepted"]}
      },
      "required": ["schema_version", "composition_epoch_id", "contract_revision", "status", "fixed_point", "intended_pack_outcome", "scope", "exclusions", "research_bound", "source_pointers", "acceptance_scenarios", "load_budget_policy", "campaign_proof_graph", "integration_result", "epoch_lock"],
      "type": "object"
    },
    "exclusions_collisions_gaps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "class": {"enum": ["exclusion", "gap", "capability", "vocabulary", "authority", "mutation", "invocation", "completion", "Return/completion", "relationship", "context-load"]},
          "essential": {"type": "boolean"},
          "future_owner_or_stopping_condition": {"type": ["string", "null"]},
          "governing_owner": {"minLength": 1, "type": "string"},
          "involved_capability_ids": {"items": {"pattern": "^CAP-[0-9]{3}$", "type": "string"}, "type": "array"},
          "involved_skill_ids": {"items": {"pattern": "^SK-[0-9]{3}$", "type": "string"}, "type": "array"},
          "issue_id": {"pattern": "^ECG-[0-9]{3}$", "type": "string"},
          "negative_control_scenario_id": {"type": ["string", "null"]},
          "nondependency_proof_ids": {"items": {"type": "string"}, "type": "array"},
          "observable_conflict": {"minLength": 1, "type": "string"},
          "resolution": {"type": ["string", "null"]},
          "status": {"enum": ["resolved", "unresolved", "deferred"]},
          "terms": {"items": {"type": "string"}, "type": "array"}
        },
        "required": ["issue_id", "class", "essential", "involved_skill_ids", "involved_capability_ids", "terms", "observable_conflict", "governing_owner", "resolution", "negative_control_scenario_id", "status", "future_owner_or_stopping_condition", "nondependency_proof_ids"],
        "type": "object"
      },
      "type": "array"
    },
    "relationships": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affected_capability_ids": {"items": {"pattern": "^CAP-[0-9]{3}$", "type": "string"}, "type": "array"},
          "callee_owned_gates_mutations": {"items": {"type": "string"}, "type": "array"},
          "caller_skill_id": {"pattern": "^SK-[0-9]{3}$", "type": "string"},
          "combined_exit_owner_skill_id": {"pattern": "^SK-[0-9]{3}$", "type": "string"},
          "context_loaded": {"items": {"type": "string"}, "type": "array"},
          "entry_condition": {"minLength": 1, "type": "string"},
          "failure_behavior": {"minLength": 1, "type": "string"},
          "input_packet": {"minLength": 1, "type": "string"},
          "ordering_impact": {"minLength": 1, "type": "string"},
          "relationship_id": {"pattern": "^REL-[0-9]{3}$", "type": "string"},
          "required_proof_ids": {"items": {"type": "string"}, "type": "array"},
          "resume_owner_skill_id": {"pattern": "^SK-[0-9]{3}$", "type": "string"},
          "return_packet": {"minLength": 1, "type": "string"},
          "target_skill_id": {"pattern": "^SK-[0-9]{3}$", "type": "string"},
          "verb": {"enum": ["Load", "Invoke", "Compose", "Hand off", "Suggest only", "Recommend and stop"]},
          "wrong_condition": {"minLength": 1, "type": "string"}
        },
        "required": ["relationship_id", "caller_skill_id", "verb", "target_skill_id", "entry_condition", "wrong_condition", "input_packet", "callee_owned_gates_mutations", "return_packet", "resume_owner_skill_id", "combined_exit_owner_skill_id", "failure_behavior", "context_loaded", "affected_capability_ids", "ordering_impact", "required_proof_ids"],
        "type": "object"
      },
      "type": "array"
    },
    "selected_skills": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance_scenario_ids": {"items": {"type": "string"}, "type": "array"},
          "campaign_state": {
            "additionalProperties": false,
            "properties": {
              "campaign_id": {"type": ["string", "null"]},
              "status": {"enum": ["not-started", "ready", "active", "terminal"]},
              "terminal_evidence_pointer": {"type": ["string", "null"]}
            },
            "required": ["status", "campaign_id", "terminal_evidence_pointer"],
            "type": "object"
          },
          "canonical_name": {"minLength": 1, "type": "string"},
          "completion_condition": {"minLength": 1, "type": "string"},
          "contract_order": {"minimum": 1, "type": "integer"},
          "essential_outcome": {"minLength": 1, "type": "string"},
          "failure_return": {"minLength": 1, "type": "string"},
          "invocation_mode": {"enum": ["implicit", "explicit-only"]},
          "load_budget_class": {"minLength": 1, "type": "string"},
          "negative_exclusion_predicates": {"items": {"type": "string"}, "type": "array"},
          "owned_authority_mutation_surfaces": {"items": {"type": "string"}, "type": "array"},
          "owned_capability_ids": {"items": {"pattern": "^CAP-[0-9]{3}$", "type": "string"}, "type": "array"},
          "positive_entry_predicate": {"minLength": 1, "type": "string"},
          "primary_role": {"enum": ["router", "executable-aggregate", "leaf"]},
          "prohibited_ownership": {"items": {"type": "string"}, "type": "array"},
          "relationship_ids": {"items": {"pattern": "^REL-[0-9]{3}$", "type": "string"}, "type": "array"},
          "required_input": {"minLength": 1, "type": "string"},
          "return_packet": {"minLength": 1, "type": "string"},
          "skill_id": {"pattern": "^SK-[0-9]{3}$", "type": "string"}
        },
        "required": ["skill_id", "canonical_name", "essential_outcome", "primary_role", "contract_order", "invocation_mode", "positive_entry_predicate", "negative_exclusion_predicates", "owned_authority_mutation_surfaces", "prohibited_ownership", "required_input", "return_packet", "completion_condition", "failure_return", "owned_capability_ids", "relationship_ids", "acceptance_scenario_ids", "load_budget_class", "campaign_state"],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": ["epoch_header", "capabilities", "selected_skills", "relationships", "exclusions_collisions_gaps"],
  "title": "Pack Composition Contract v1",
  "type": "object"
}
