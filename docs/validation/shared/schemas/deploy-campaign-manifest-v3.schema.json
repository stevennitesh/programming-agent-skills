{
  "$id": "urn:programming-agent-skills:deploy-campaign-manifest:v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "campaign": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "skill": {
          "$ref": "#/$defs/safeId"
        },
        "epoch": {
          "$ref": "#/$defs/safeId"
        },
        "composition_epoch_id": {
          "pattern": "^FCE-[0-9]{8}-[0-9]{2}$",
          "type": "string"
        },
        "controller_profile": {
          "const": "four-gate-shadow-v1"
        },
        "delivery_mode": {
          "enum": [
            "none",
            "commit",
            "push"
          ]
        },
        "continuation": {
          "enum": [
            "restart",
            null
          ]
        },
        "supersession": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^docs/validation/skills/[a-z0-9][a-z0-9-]*/campaigns/[a-z0-9][a-z0-9-]*/manifest\\.json$",
              "type": "string"
            }
          ]
        },
        "worktree": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "skill",
        "epoch",
        "composition_epoch_id",
        "controller_profile",
        "delivery_mode",
        "continuation",
        "supersession",
        "worktree"
      ],
      "type": "object"
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "candidate_root": {
          "minLength": 1,
          "type": "string"
        },
        "pack_contract": {
          "$ref": "#/$defs/revisionedPointer"
        },
        "proof_predecessors": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "installed": {
                "$ref": "#/$defs/artifactPointer"
              },
              "p1": {
                "$ref": "#/$defs/artifactPointer"
              }
            },
            "required": [
              "id",
              "p1",
              "installed"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "schedule_pointer": {
          "minLength": 1,
          "type": "string"
        },
        "schedule_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "selected_capability_ids": {
          "$ref": "#/$defs/identityList"
        },
        "selected_relationship_ids": {
          "$ref": "#/$defs/identityList"
        },
        "selected_scenario_ids": {
          "$ref": "#/$defs/identityList"
        },
        "slice": {
          "additionalProperties": false,
          "properties": {
            "fingerprint": {
              "$ref": "#/$defs/fingerprint"
            },
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id",
            "path",
            "fingerprint"
          ],
          "type": "object"
        }
      },
      "required": [
        "candidate_root",
        "pack_contract",
        "slice",
        "selected_capability_ids",
        "selected_relationship_ids",
        "selected_scenario_ids",
        "proof_predecessors",
        "schedule_pointer",
        "schedule_fingerprint"
      ],
      "type": "object"
    },
    "semantic": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal_token": {
                "const": "campaign-complete"
              }
            },
            "required": [
              "terminal_token"
            ]
          },
          "then": {
            "properties": {
              "current_gate": {
                "const": "release"
              }
            }
          }
        }
      ],
      "properties": {
        "current_gate": {
          "enum": [
            "contract-lock",
            "candidate-lock",
            "behavioral-proof",
            "release"
          ]
        },
        "decision_pointers": {
          "additionalProperties": false,
          "properties": {
            "contract_lock": {
              "$ref": "#/$defs/decisionPointer"
            },
            "candidate_lock": {
              "$ref": "#/$defs/decisionPointer"
            },
            "behavioral_proof": {
              "$ref": "#/$defs/decisionPointer"
            },
            "release": {
              "$ref": "#/$defs/decisionPointer"
            }
          },
          "required": [
            "contract_lock",
            "candidate_lock",
            "behavioral_proof",
            "release"
          ],
          "type": "object"
        },
        "terminal_token": {
          "enum": [
            "campaign-complete",
            null
          ]
        }
      },
      "required": [
        "current_gate",
        "terminal_token",
        "decision_pointers"
      ],
      "type": "object"
    },
    "mechanical": {
      "additionalProperties": false,
      "properties": {
        "artifact_identities": {
          "items": {
            "$ref": "#/$defs/publicMechanicalValue"
          },
          "type": "array"
        },
        "campaign_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "contract_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "evidence_state": {
          "enum": [
            "current",
            "stale"
          ]
        },
        "gates": {
          "additionalProperties": false,
          "properties": {
            "contract_lock": {
              "$ref": "#/$defs/gateMechanical"
            },
            "candidate_lock": {
              "$ref": "#/$defs/gateMechanical"
            },
            "behavioral_proof": {
              "$ref": "#/$defs/gateMechanical"
            },
            "release": {
              "$ref": "#/$defs/gateMechanical"
            }
          },
          "required": [
            "contract_lock",
            "candidate_lock",
            "behavioral_proof",
            "release"
          ],
          "type": "object"
        },
        "invalidations": {
          "items": {
            "$ref": "#/$defs/publicMechanicalValue"
          },
          "type": "array"
        },
        "parity": {
          "$ref": "#/$defs/publicMechanicalValue"
        },
        "preflight_registrations": {
          "items": {
            "$ref": "#/$defs/publicMechanicalValue"
          },
          "type": "array"
        },
        "proof_registrations": {
          "items": {
            "$ref": "#/$defs/publicMechanicalValue"
          },
          "type": "array"
        },
        "receipts": {
          "items": {
            "$ref": "#/$defs/publicMechanicalValue"
          },
          "type": "array"
        },
        "semantic_repair_generation": {
          "minimum": 0,
          "type": "integer"
        },
        "supersession_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "created_at",
        "verified_at",
        "campaign_digest",
        "supersession_digest",
        "contract_digest",
        "artifact_identities",
        "proof_registrations",
        "preflight_registrations",
        "receipts",
        "invalidations",
        "parity",
        "evidence_state",
        "gates",
        "semantic_repair_generation"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "campaign",
    "contract",
    "semantic",
    "mechanical"
  ],
  "type": "object",
  "$defs": {
    "artifactPointer": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "fingerprint"
      ],
      "type": "object"
    },
    "decisionPointer": {
      "pattern": "^decisions\\.md#[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "fingerprint": {
      "pattern": "^sha256-v1:[0-9a-f]{64}$",
      "type": "string"
    },
    "gateMechanical": {
      "additionalProperties": false,
      "properties": {
        "evidence_state": {
          "enum": [
            "current",
            "stale"
          ]
        },
        "receipt_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "registration_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "evidence_state",
        "registration_ids",
        "receipt_ids"
      ],
      "type": "object"
    },
    "identityList": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "publicMechanicalValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/publicMechanicalValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/publicMechanicalValue"
          },
          "propertyNames": {
            "not": {
              "pattern": "([Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Ee][Vv][Aa][Ll][Uu][Aa][Tt][Oo][Rr])"
            }
          },
          "type": "object"
        }
      ]
    },
    "revisionedPointer": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "revision",
        "fingerprint"
      ],
      "type": "object"
    },
    "safeId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    }
  }
}
